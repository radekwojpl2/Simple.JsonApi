<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <!-- The published packages, not project references: this sample consumes the libraries the
             way an outside caller would. The preview version is what the pull request publishes;
             it becomes a release version once the branch merges. -->
        <PackageReference Include="Simple.JsonApi" Version="1.0.1-preview.6.34" />
        <PackageReference Include="Simple.JsonApi.OpenApi" Version="1.0.1-preview.6.34" />
    </ItemGroup>

    <ItemGroup>
        <!-- Program.cs calls AddOpenApi/MapOpenApi directly, so the app names that package itself
             rather than leaning on the transitive reference. The Microsoft.OpenApi pin that used to
             live here now sits in JsonApiLite.OpenApi, which is what puts it on the graph.
             Two interchangeable readers over the one document (/openapi/v1.json): the standalone
             Swagger UI and Scalar. -->
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.1" />
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
        <PackageReference Include="Scalar.AspNetCore" Version="2.16.16" />
    </ItemGroup>

</Project>
