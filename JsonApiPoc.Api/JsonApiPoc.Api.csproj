<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <!-- The published package, not a project reference: this sample consumes JsonApiLite
             the way an outside caller would. The scaffold's OpenApi reference is gone: these
             endpoints write JSON:API text directly, so it described nothing, and it dragged in
             Microsoft.OpenApi 2.0.0 (NU1903, high severity). -->
        <PackageReference Include="Simple.JsonApi" Version="1.0.0"/>
    </ItemGroup>

</Project>
